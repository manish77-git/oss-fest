# Server configuration
PORT=4000
NODE_ENV=development

# Database connection
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/campusconnect?schema=public"

# Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Optional College Email Domain Restriction
# Comma-separated domains e.g. "college.edu,stanford.edu,mit.edu". Leave empty to allow any valid email.
# Note: Domain validation alone does not prove active student enrollment.
ALLOWED_EMAIL_DOMAINS=

# Local AI (Ollama) configuration
# Ollama must be running locally; model calls stay on the backend.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Request timeout in milliseconds for local AI calls.
# Generous by default because CPU-only machines must load the model and evaluate the prompt on the first call.
OLLAMA_TIMEOUT_MS=180000

# CORS Configuration
CORS_ORIGIN=*
