# Server configuration
PORT=4000
NODE_ENV=development

# Database connection
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/campusconnect?schema=public"

# Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Optional College Email Domain Restriction
# Comma-separated domains e.g. "college.edu,stanford.edu,mit.edu". Leave empty to allow any valid email.
# Note: Domain validation alone does not prove active student enrollment.
ALLOWED_EMAIL_DOMAINS=

# CORS Configuration
CORS_ORIGIN=*
